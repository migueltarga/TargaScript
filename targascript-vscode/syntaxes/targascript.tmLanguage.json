{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TargaScript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.targascript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.targascript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.targascript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.targascript",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.interpolation.targascript",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.targascript" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.targascript" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.targascript",
          "match": "\\b(if|else|return|repeat|in|break|continue|load|as|await|try|catch|throw|match)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.targascript",
          "match": "\\b(let|const|fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.targascript",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.targascript",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.targascript",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        },
        {
          "name": "entity.name.function.targascript",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.targascript",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.compound.targascript",
          "match": "(\\*\\*|\\?\\?|[-+*/%])="
        },
        {
          "name": "keyword.operator.spread.targascript",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.targascript",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.increment-decrement.targascript",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.range.targascript",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.targascript",
          "match": "\\?\\?|\\?\\.|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.targascript",
          "match": "\\*\\*|\\+|-|\\*|\\/|\\^|%"
        },
        {
          "name": "keyword.operator.assignment.targascript",
          "match": "="
        },
        {
          "name": "keyword.operator.accessor.targascript",
          "match": "\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.targascript",
          "match": "\\b0([xX][0-9a-fA-F_]+|[bB][01_]+|[oO][0-7_]+)\\b"
        },
        {
          "name": "constant.numeric.float.targascript",
          "match": "\\b[0-9][0-9_]*(\\.[0-9]+)?[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.targascript",
          "match": "\\b[0-9][0-9_]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.targascript",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.targascript"
} 