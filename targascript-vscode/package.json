{
  "name": "targascript",
  "displayName": "TargaScript",
  "description": "Syntax highlighting and error checking for TargaScript (.tg) files",
  "version": "0.6.0",
  "publisher": "migueltarga",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:targascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "targascript",
        "aliases": [
          "TargaScript",
          "targascript"
        ],
        "extensions": [
          ".tg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "targascript",
        "scopeName": "source.targascript",
        "path": "./syntaxes/targascript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "targascript",
        "path": "./snippets/targascript.json"
      }
    ],
    "commands": [
      {
        "command": "targascript.runFile",
        "title": "Run File",
        "category": "TargaScript",
        "icon": "$(play)"
      },
      {
        "command": "targascript.testFile",
        "title": "Run Tests in File",
        "category": "TargaScript"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "targascript.runFile",
          "when": "resourceLangId == targascript"
        }
      ],
      "commandPalette": [
        {
          "command": "targascript.runFile",
          "when": "editorLangId == targascript"
        },
        {
          "command": "targascript.testFile",
          "when": "editorLangId == targascript"
        }
      ]
    },
    "keybindings": [
      {
        "command": "targascript.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == targascript"
      }
    ],
    "configuration": {
      "title": "TargaScript",
      "properties": {
        "targascript.path": {
          "type": "string",
          "default": "targascript",
          "description": "The targascript command that Run File uses"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/migueltarga/TargaScript"
  },
  "keywords": [
    "targascript",
    "tg",
    "syntax",
    "highlighting",
    "snippets",
    "diagnostics"
  ],
  "author": "Miguel Targa",
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "sh build.sh"
  }
}
