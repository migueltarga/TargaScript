// Lesson 3: Strings
//
// Strings have methods for the usual work. Positions count characters,
// starting at 0.

let text = "  TargaScript is fun  "
let clean = text.trim()

print(clean.upper())
print(clean.length, "characters")
print(clean[0], clean.slice(-3))
print(clean.split(" "))
print(clean.replace("fun", "simple"))
print("ha".repeat(3), "7".padStart(3, "0"))
