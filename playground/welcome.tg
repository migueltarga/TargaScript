// Welcome to TargaScript!
// Edit this code and press Run (or Ctrl+Enter).
// New here? Take the tour: pick "1. Hello, TargaScript" in the menu above.

fn greet(name = "world") { "Hello, ${name}!" }
print(greet())

// Pipes and array methods; it is the value going through
(1..10)
    |> it.map(it * it)
    |> it.filter(it % 2 == 0)
    |> print

// match, with guards
fn describe(celsius) {
    match celsius {
        0 => "freezing point"
        _ if celsius < 0 => "below zero"
        1..25 => "mild"
        _ => "hot"
    }
}
print([-5, 0, 18, 32].map(describe))

// Taking values apart, with defaults
let {name, language = "TargaScript"} = {name: "Ana"}
print("${name} writes ${language}")

// Objects keep their order, and JSON is built in
let years = parseJSON(`{"Lua": 1993, "JavaScript": 1995, "TargaScript": 2025}`)
repeat language, year in years {
    print("${language.padEnd(12)} ${year}")
}

// These three waits run side by side
let started = clock()
await all([1, 2, 3].map(fn(n) {
    await sleep(300)
    n
}))
print("3 waits of 300 ms took ${round(clock() - started)} ms")

// Tests are built in
test("greet uses the name", fn() {
    assertEqual(greet("Bia"), "Hello, Bia!")
})
