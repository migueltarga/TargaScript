// Errors, as values a program can catch

fn messageOf(f) {
    try { f(); null } catch e { e.message }
}

test("throw and catch", fn() {
    assertEqual(messageOf(() => { throw "boom" }), "boom")
})

test("finally runs however try ends", fn() {
    let log = []
    fn early() {
        try { return "returned" } finally { log += ["return"] }
    }
    assertEqual(early(), "returned")
    assertEqual(messageOf(() => { try { throw "boom" } finally { log += ["error"] } }), "boom")
    repeat i in 1..3 {
        try {
            if i == 1 { continue }
            break
        } finally {
            log += ["loop ${i}"]
        }
    }
    assertEqual(log, ["return", "error", "loop 1", "loop 2"])
})

test("finally keeps the value of try or catch", fn() {
    assertEqual(try { 1 } finally { 2 }, 1)
    assertEqual(try { throw "x" } catch { 3 } finally { 4 }, 3)
})

test("assertions are catchable errors", fn() {
    assertEqual(messageOf(() => assertEqual(1, 2)), "assertion failed: expected 2, got 1")
})

test("names from other languages get a hint", fn() {
    let message = messageOf(() => [1].push(2))
    assert("use insert(value)" in message, message)
})

test("match picks the first arm that fits", fn() {
    fn size(n) {
        match n {
            0 => "none"
            1..9 => "small"
            _ => "big"
        }
    }
    assertEqual([0, 5, 50].map(size), ["none", "small", "big"])
})
