// The operators, checked with the language's own test runner

test("+ joins strings and arrays", fn() {
    assertEqual("a" + "b", "ab")
    assertEqual([1] + [2, 3], [1, 2, 3])
})

test("* repeats strings", fn() {
    assertEqual("ab" * 3, "ababab")
    assertEqual(2 * "-", "--")
})

test("negative indexes count from the end", fn() {
    let list = [1, 2, 3]
    assertEqual(list[-1], 3)
    assertEqual("hello"[-1], "o")
    list[-1] = 9
    assertEqual(list, [1, 2, 9])
})

test("in finds elements, keys, substrings and numbers in ranges", fn() {
    assert(2 in [1, 2])
    assert("name" in {name: "Ana"})
    assert("ell" in "hello")
    assert(5 in 1..10)
    assert(!(11 in 1..10))
})

test("number literals", fn() {
    assertEqual(1_000_000, 1000000)
    assertEqual(0xff, 255)
    assertEqual(0b1010, 10)
    assertEqual(0o17, 15)
})

test("|> passes the value as the first argument", fn() {
    fn add(x, n) { x + n }
    assertEqual(5 |> add(3), 8)
    assertEqual("  hi " |> (s => s.trim()) |> (s => s.upper()), "HI")
})

test("?? and ?. handle null", fn() {
    let user = {address: null}
    assertEqual(user.address?.city ?? "unknown", "unknown")
})

test("** groups to the right", fn() {
    assertEqual(2 ** 3 ** 2, 512)
})
