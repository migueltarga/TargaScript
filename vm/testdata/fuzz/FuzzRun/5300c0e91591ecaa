string("//\nfn is_prime(num){//\nif num<2{n}//\nif num==2{}//\nif num%2==0{return false}//\nlet i=3 let checking=true repeat checking{if i*i>num{checking false\n      continue\n    }\n    \n    if num % i == 0 {\n      return false\n    }\n    i = i + 2\n  }\n  \n  return true\n}\n\n// Function to generate all prime numbers up to n\nfn generate_primes_up_to(n) {\n  let primes = []\n  \n  // Create range and iterate\n  let numbers = range(2, n)\n  repeat i in numbers {\n    if is_prime(i) {\n      primes = primes.insert(i)\n    }\n  }\n  \n  return primes\n}\n\n// Function to get the first n prime numbers\nfn first_n_primes(n) {\n  let primes = []\n  let count = 0\n  let num = 2\n  \n  let running = true\n  repeat running {\n    if count >= n {\n      running = false\n      continue\n    }\n    \n    if is_prime(num) {\n      primes = primes.insert(num)\n      count = count + 1\n    }\n    num = num + 1\n  }\n  \n  return primes\n}\n\n// Helper function to generate range\nfn range(start, end) {\n  // Base case\n  if start > end {\n    return []\n  }\n  \n  // Create range from start+1 to end, then add start at the beginning\n  let rest = range(start + 1, end)\n  let result = [start]\n  \n  // Add all elements from rest to result\n  repeat item in rest {\n    result = result.insert(item)\n  }\n  \n  return result\n}\n\n// Example usage\nprint(\"Is 7 prime? \" + is_prime(7))    // true\nprint(\"Is 12 prime? \" + is_prime(12))  // false\nprint(\"Is 23 prime? \" + is_prime(23))  // true\nprint(\"Is 1 prime? \" + is_prime(1))")
